{
  "name": "arkst-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && node --test tests/integration/local-helpers.test.mjs tests/integration/push-worker-click.test.mjs",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke.mjs",
    "test:identity": "node scripts/test-local-identity.mjs",
    "test:activities": "node scripts/test-local-activities.mjs",
    "test:directory": "node scripts/test-local-directory.mjs",
    "test:operations": "node scripts/test-local-operations.mjs",
    "test:push": "node scripts/test-local-push.mjs",
    "push:generate-local-keys": "node scripts/generate-local-vapid.mjs",
    "push:dispatch:local": "node scripts/dispatch-local-push.mjs",
    "push:watch:local": "node scripts/dispatch-local-push.mjs --watch",
    "push:dispatch": "node scripts/dispatch-notifications.mjs",
    "test:directory-admin": "node scripts/directory-admin.mjs",
    "test:local": "node scripts/run-local-verification.mjs",
    "test:rls": "supabase test db --local",
    "supabase:start:identity": "supabase start --exclude realtime,storage-api,imgproxy,mailpit,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
